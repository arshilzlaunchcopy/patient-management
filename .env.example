# Copy to .env.local for local development. Real values live in .env.local (never committed)
# and in the Netlify dashboard for the deployed site.

# Supabase project URL — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key — safe to ship to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase service role / secret key — SERVER ONLY, never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Public base URL of the app, used to build links sent to patients
# Local: http://localhost:3000   Production: https://your-site.netlify.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
